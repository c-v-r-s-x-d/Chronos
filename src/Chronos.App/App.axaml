<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Chronos.App.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Chronos.App/Theme/Palette.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <!-- The accent is the palette's, not the system's. -->
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#FF8A6A24" RegionColor="#FFF6F3EC" />
        <ColorPaletteResources x:Key="Dark" Accent="#FFC9A45C" RegionColor="#FF15161A" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://Chronos.App/Theme/Styles.axaml" />
  </Application.Styles>
</Application>

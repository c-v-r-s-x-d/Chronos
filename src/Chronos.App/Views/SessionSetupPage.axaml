<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Chronos.App.ViewModels"
             x:Class="Chronos.App.Views.SessionSetupPage"
             x:DataType="vm:SetupViewModel">
  <!-- The "Session" section with no session running. -->
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="20" Margin="32,28" MaxWidth="560" HorizontalAlignment="Left">
      <TextBlock Classes="h1" Text="{Binding Text.NewSessionHeading}" TextWrapping="Wrap" />
      <!-- What the service said about the last command here (a start it refused or clamped). -->
      <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" IsVisible="{Binding HasNotice}" />

      <ListBox Classes="chips" ItemsSource="{Binding Durations}"
               SelectedIndex="{Binding SelectedDuration, Mode=TwoWay}">
        <ListBox.Styles>
          <Style Selector="ListBoxItem" x:DataType="vm:DurationLine">
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:DurationLine">
            <TextBlock Text="{Binding Name}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsCustomDuration}">
        <NumericUpDown Value="{Binding Minutes}" Minimum="5" Maximum="1440" Increment="5" Width="140" FormatString="0" />
        <TextBlock Classes="muted" VerticalAlignment="Center" Text="{Binding Text.MinutesLabel}" />
      </StackPanel>

      <TextBlock Classes="muted" Text="{Binding Summary}" IsVisible="{Binding !NothingToBlock}" TextWrapping="Wrap" />
      <StackPanel IsVisible="{Binding NothingToBlock}" Spacing="6">
        <TextBlock Classes="muted" Text="{Binding Text.NothingToBlock}" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Button Classes="link" Content="{Binding Text.GoToSites}"
                  Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).GoToCommand}"
                  CommandParameter="{x:Static vm:Section.Sites}" />
          <Button Classes="link" Content="{Binding Text.GoToApps}"
                  Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).GoToCommand}"
                  CommandParameter="{x:Static vm:Section.Apps}" />
        </StackPanel>
      </StackPanel>

      <Button Classes="primary" HorizontalAlignment="Left"
              Content="{Binding Text.StartSession}" Command="{Binding StartCommand}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>

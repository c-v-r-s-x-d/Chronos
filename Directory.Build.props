<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The one version number: the programs and, through the installer project, the MSI. -->
    <Version>1.0.0</Version>
    <!-- Embedded in every executable, so Explorer and the shortcuts show it. -->
    <ApplicationIcon>$(MSBuildThisFileDirectory)assets\chronos.ico</ApplicationIcon>
  </PropertyGroup>
</Project>

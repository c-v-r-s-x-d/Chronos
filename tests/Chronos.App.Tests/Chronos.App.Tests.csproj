<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Chronos.App\Chronos.App.csproj" />
  </ItemGroup>

  <!--
    The one reference to the service that is allowed anywhere near the interface, and it is here
    rather than in Chronos.App: these tests talk to a real IpcServer on a pipe of their own instead
    of to a stand-in that would agree with whatever the link believes. ArchitectureTests asserts
    that this reference stops at the test assembly.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Chronos.Service\Chronos.Service.csproj" />
  </ItemGroup>

</Project>
